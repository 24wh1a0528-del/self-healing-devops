# ──────────────────────────────────────────────────────────────
# .dockerignore
#
# This file tells Docker which files and folders to EXCLUDE
# when building the image. Just like .gitignore excludes files
# from Git, .dockerignore excludes files from Docker builds.
#
# Why does this matter?
# - Keeps the image small (no unnecessary files inside)
# - Speeds up the build (less data to send to Docker)
# - Improves security (no secrets or dev files in production image)
# ──────────────────────────────────────────────────────────────


# ── Python cache files ─────────────────────────────────────────
# These are auto-generated by Python and not needed in the image
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo


# ── Virtual environments ───────────────────────────────────────
# If you created a local virtual environment, exclude it.
# The container installs its own dependencies via requirements.txt
venv/
.venv/
env/
.env/


# ── Test files ─────────────────────────────────────────────────
# Tests are for development only — not needed in the production image
tests/
pytest.ini
.pytest_cache/


# ── Coverage reports ───────────────────────────────────────────
.coverage
htmlcov/
coverage.xml


# ── Editor and OS files ────────────────────────────────────────
# These are created by your code editor or operating system
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db


# ── Git files ──────────────────────────────────────────────────
# No need for version control history inside the container
.git/
.gitignore


# ── Environment variable files ─────────────────────────────────
# IMPORTANT: Never include .env files — they often contain secrets!
.env
*.env
